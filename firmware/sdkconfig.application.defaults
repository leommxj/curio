# CONFIG_ESP_IRIS_OTA is not set
CONFIG_ESP_IRIS_USB_PRODUCT="ESP-Iris Curio"
CONFIG_ESP_IRIS_HEALTH_TIMEOUT_MS=45000
CONFIG_BSP_MOTOR_ENABLE_PWM=y
# CONFIG_ESP_MOSAICO_APP_AUTO_ACCEPT is not set
# Keep the retained 24 KiB bootloader window; application diagnostics stay enabled.
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
